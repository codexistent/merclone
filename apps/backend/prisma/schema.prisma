/*
  To save/update changes for Prisma file, do:
      bunx prisma migrate dev --name your-version-name
      bunx prisma generate
*/

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Interview {
  id              String          @id     @default(uuid())
  githubMetadata  Json
  status          InterviewStatus @default(Pre)
  score           Int?
  feedback        String?
  createdAt       DateTime        @default(now())
  conversations   Message[]
}

model Message {
  id              String          @id     @default(uuid())
  interviewId     String 
  interview       Interview       @relation(fields: [interviewId], references: [id])
  type            MessageType
  message         String
  createdAt       DateTime        @default(now())

  @@index([interviewId, createdAt])
}

enum MessageType {
  User
  Assistant
}

enum InterviewStatus {
  Pre 
  InProgress
  Grading
  Done
  Failed
}